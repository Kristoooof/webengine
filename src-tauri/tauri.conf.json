{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rozsda Kurzus",
  "version": "0.1.0",
  "identifier": "hu.rozsda.kurzus",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "publisher": "Rozsda",
    "copyright": "© 2026 Rozsda",
    "category": "Education",
    "shortDescription": "Építs saját böngészőmotort Rustban",
    "longDescription": "ADHD-barát, magyar nyelvű kurzus: saját böngészőmotor Rustban, nulláról a mai webig.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Hungarian",
          "English"
        ],
        "displayLanguageSelector": false,
        "customLanguageFiles": {
          "Hungarian": "nsis/Hungarian.nsh"
        }
      }
    }
  }
}
